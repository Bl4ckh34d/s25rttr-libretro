+#ifdef RTTR_LIBRETRO
+// GLES resources belong to the frontend context and must not survive its teardown.
+static std::unique_ptr<Loader> libretroLoader;
+void ResetLibretroResources() { libretroLoader.reset(); }
+Loader& getGlobalLoader()
+{
+    if(!libretroLoader)
