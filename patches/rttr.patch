 void AudioSDL::StopMusic()
 {
+#ifdef RTTR_LIBRETRO
+    // Audio advances only inside retro_run. Waiting for a fade during context
+    // teardown would deadlock when Mix_FreeMusic waits for that fade to finish.
+    Mix_HaltMusic();
+#else
     // Musik anhalten
     Mix_FadeOutMusic(1000);
+#endif
 }
 
 void AudioSDL::doStopEffect(int channel)
