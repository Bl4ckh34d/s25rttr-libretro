# Dependencies are built from the revisions pinned by the Android port.
set(Boost_FOUND TRUE)
set(Boost_VERSION 108500)
set(Boost_VERSION_STRING 1.85.0)
set(Boost_VERSION_MAJOR 1)
set(Boost_VERSION_MINOR 85)
set(Boost_INCLUDE_DIRS ${RTTR_BOOST_INCLUDES})
set(Boost_LIBRARIES "")
foreach(component IN LISTS Boost_FIND_COMPONENTS)
  if(NOT TARGET Boost::${component})
    message(FATAL_ERROR "Missing bundled Boost component ${component}")
  endif()
  string(TOUPPER ${component} upper)
  set(Boost_${upper}_FOUND TRUE)
  list(APPEND Boost_LIBRARIES Boost::${component})
endforeach()
